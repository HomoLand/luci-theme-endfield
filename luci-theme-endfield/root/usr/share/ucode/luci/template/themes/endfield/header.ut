{#
 luci-theme-endfield — Arknights: Endfield Industrial Theme for LuCI 25.12
 Licensed under the Apache License 2.0.
-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const boardinfo = ubus.call('system', 'board') ?? {};
	const darkpref = (theme == 'endfield-dark' ? 'true' : (theme == 'endfield-light' ? 'false' : null));
	const hostname = striptags(boardinfo.hostname ?? 'OpenWrt');
	const target = striptags(boardinfo.release?.target ?? '');
	const kernel = striptags(boardinfo.kernel ?? '');

	let dock_url = '#';
	let dock_label = _('Overview');
	if (!blank_page) {
		const dock_has_console = dispatcher.lookup('admin/endfield') ? true : false;
		dock_url = dock_has_console
			? dispatcher.build_url('admin/endfield')
			: (dispatcher.lookup('admin/status/overview')
				? dispatcher.build_url('admin/status/overview')
				: dispatcher.build_url());
		dock_label = dock_has_console ? _('Console') : _('Overview');
	}

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}" data-ef-theme="{{ entityencode(theme ?? 'endfield', true) }}"{{ darkpref ? ` data-darkmode="${darkpref}"` : '' }}>
	<head>
		<meta charset="utf-8">
		<title>{{ striptags(`${hostname}${dispatched?.title ? ` // ${_(dispatched.title)}` : ''}`) }}</title>
		<script>
			(function() {
				var root = document.documentElement;
				var fixed = root.getAttribute('data-darkmode');
				if (fixed === 'true' || fixed === 'false') return;
				var saved = null;
				try { saved = localStorage.getItem('luci_endfield_darkmode'); } catch (e) {}
				if (saved === 'true' || saved === 'false') {
					root.setAttribute('data-darkmode', saved);
				} else {
					var mq = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
					var apply = function(m) {
						try {
							if (localStorage.getItem('luci_endfield_darkmode') !== null) return;
						} catch (e) {}
						root.setAttribute('data-darkmode', m && m.matches ? 'true' : 'false');
					};
					apply(mq);
					if (mq && mq.addEventListener) mq.addEventListener('change', apply);
				}
			})();
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
		<meta name="darkreader-lock">
		<link rel="preload" href="{{ media }}/fonts/chakra-petch-700.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="{{ media }}/fonts/jetbrains-mono-500.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="stylesheet" href="{{ media }}/cascade.css?v=25.12-ef32">
		<link rel="stylesheet" media="only screen and (max-width: 860px)" href="{{ media }}/mobile.css?v=25.12-ef32">
		<link rel="icon" href="{{ media }}/logo.svg" type="image/svg+xml" sizes="any">
		{% if (node?.css): %}
		<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
		{% endif %}
		{% if (css): %}
		<style title="text/css">{{ css }}</style>
		{% endif %}
		<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
		<script src="{{ resource }}/cbi.js?v=25.12-ef32"></script>
	</head>

	<body class="lang_{{ dispatcher.lang }} {{ entityencode(striptags(node?.title ?? ''), true) }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
		{% if (!blank_page): %}
		<div class="ef-shell" id="ef-shell">
			<div class="ef-drawer-backdrop" id="ef-drawer-backdrop"></div>

			<aside class="ef-sidebar" id="ef-sidebar" aria-label="{{ _('Navigation') }}">
				<a class="ef-brand-block" href="{{ dispatcher.build_url() }}">
					<span class="ef-brand-emblem" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="none">
							<path d="M12 2L21 7.2V16.8L12 22L3 16.8V7.2L12 2Z" stroke="currentColor" stroke-width="2.1"/>
							<path d="M12 6.5L17 9.4V14.6L12 17.5L7 14.6V9.4L12 6.5Z" fill="currentColor"/>
							<path d="M12 2V6.5M21 7.2L17 9.4M3 7.2L7 9.4" stroke="currentColor" stroke-width="1.6"/>
						</svg>
					</span>
					<span class="ef-brand-text">
						<span class="ef-brand-title">{{ hostname }}</span>
						<span class="ef-brand-sub">{{ striptags(`${version.distname ?? 'OpenWrt'} ${version.distversion ?? ''}`) }}</span>
					</span>
				</a>

				<nav class="ef-sidebar-scroll" id="mainmenu"></nav>

				<div class="ef-sidebar-footer">
					<div class="ef-sidebar-node-meta">
						<div class="meta-row">
							<span>SECTOR</span>
							<span class="meta-val ef-only-light">TALOS-II</span>
							<span class="meta-val ef-only-dark">OMV DIJIANG</span>
						</div>
						{% if (target): %}
						<div class="meta-row"><span>ARCH</span><span class="meta-val">{{ target }}</span></div>
						{% endif %}
						{% if (kernel): %}
						<div class="meta-row"><span>KERNEL</span><span class="meta-val">{{ kernel }}</span></div>
						{% endif %}
					</div>

					<div class="ef-rail-capsule" role="toolbar" aria-label="{{ _('Quick controls') }}">
						<button type="button" class="ef-capsule-btn" id="ef-mode-toggle" data-ef-action="mode" title="Toggle Dark / Light Mode" aria-label="Toggle Dark / Light Mode">
							<svg data-mode-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
							<svg data-mode-icon="moon" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
							<span class="ef-capsule-label" data-ef-mode-label>LIGHT</span>
						</button>
						<button type="button" class="ef-capsule-btn" id="ef-cmd-trigger" data-ef-action="cmd" title="Command Palette (Ctrl+K)" aria-label="Command Palette (Ctrl+K)">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
							<span class="ef-capsule-label">^K</span>
						</button>
						<button type="button" class="ef-capsule-btn" id="ef-collapse-sidebar" data-ef-action="collapse" title="{{ _('Collapse sidebar') }} ([)" aria-label="{{ _('Collapse sidebar') }} ([)">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16"/><line x1="9" y1="4" x2="9" y2="20"/></svg>
							<span class="ef-capsule-label">[</span>
						</button>
					</div>

					<a class="ef-rail-dock-btn" id="ef-rail-dock-btn" href="{{ dock_url }}" title="{{ dock_label }}">
						<svg class="ef-dock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polygon points="12 2 21 7 21 17 12 22 3 17 3 7 12 2"/>
							<polygon points="12 8 16 10.3 16 13.7 12 16 8 13.7 8 10.3 12 8" fill="currentColor" stroke="none"/>
						</svg>
						<span class="ef-dock-label" id="ef-dock-label">{{ dock_label }}</span>
						<span class="ef-dock-arrow" aria-hidden="true">↗</span>
					</a>
				</div>
			</aside>

			<div class="ef-main">
				<header class="ef-header">
					<button type="button" class="ef-mobile-menu-btn" id="ef-mobile-menu-btn" aria-label="{{ _('Menu') }}">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
					</button>

					<div class="ef-breadcrumb">
						<span class="ef-crumb-tag" id="ef-crumb-tag">↘ {{ dispatched?.title ? striptags(_(dispatched.title)) : 'GATEWAY' }}</span>
						<span class="ef-crumb-path" id="ef-crumb-path"><strong>{{ dispatched?.title ? _(dispatched.title) : hostname }}</strong></span>
					</div>

					<ul class="nav" id="topmenu" style="display:none"></ul>

					<div class="ef-header-actions">
						<span class="ef-header-sector" aria-hidden="true">
							<span class="ef-sector-dot"></span>
							<span class="ef-only-light">EF-IND // TALOS-II</span>
							<span class="ef-only-dark">EF-IND // OMV DIJIANG</span>
						</span>
						<span class="ef-dot-matrix ef-header-dots" aria-hidden="true"></span>

						<button type="button" class="ef-cmd-trigger ef-header-mobile-only" data-ef-action="cmd" title="Command Palette (Ctrl+K)">
							<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
							<span class="ef-kbd">^K</span>
						</button>

						<button type="button" class="ef-mode-toggle ef-header-mobile-only" data-ef-action="mode" title="Toggle Dark / Light Mode">
							<svg data-mode-icon="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
							<svg data-mode-icon="moon" style="display:none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
							<span data-ef-mode-label>LIGHT</span>
						</button>

						<div id="indicators" class="pull-right"></div>
					</div>
				</header>

				<div id="maincontent" class="container">
					{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
						<div class="alert-message warning">
							<div>
								<h4>{{ _('No password set!') }}</h4>
								<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
							</div>
							{% if (dispatcher.lookup("admin/system/admin")): %}
							<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/admin") }}">{{ _('Go to password configuration...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					{% if (boardinfo.rootfs_type == "initramfs"): %}
						<div class="alert-message warning">
							<div>
								<h4>{{ _('System running in recovery (initramfs) mode.') }}</h4>
								<p>{{ _('No changes to settings will be stored and are lost after rebooting. This mode should only be used to install a firmware upgrade') }}</p>
							</div>
							{% if (dispatcher.lookup("admin/system/flash")): %}
							<div class="right"><a class="btn" href="{{ dispatcher.build_url("admin/system/flash") }}">{{ _('Go to firmware upgrade...') }}</a></div>
							{% endif %}
						</div>
					{% endif %}

					<noscript>
						<div class="alert-message warning">
							<div>
								<h4>{{ _('JavaScript required!') }}</h4>
								<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
							</div>
						</div>
					</noscript>

					<div id="tabmenu" style="display:none"></div>
		{% endif %}
