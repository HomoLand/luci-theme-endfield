		{% if (!blank_page): %}
				</div>
				<footer class="ef-footer">
					<span>
						Powered by
						<a href="https://github.com/openwrt/luci" target="_blank" rel="noreferrer">{{ version.luciname }} ({{ version.luciversion }})</a>
						/
						<a href="{{ entityencode(version.disturl ?? '#', true) }}" target="_blank" rel="noreferrer">{{ version.distname }} {{ version.distversion }} ({{ version.distrevision }})</a>
						{% if (lua_active): %}
							/ {{ _('Lua compatibility mode active') }}
						{% endif %}
					</span>
					<div class="ef-footer-right">
						<ul class="breadcrumb" id="modemenu" style="display:none"></ul>
						<span class="ef-footer-stamp">
							<span class="ef-only-light">ENDFIELD IND. // TALOS-II PAC</span>
							<span class="ef-only-dark">ENDFIELD IND. // OMV DIJIANG</span>
						</span>
					</div>
				</footer>
			</div>
		</div>

		<div class="ef-cmd-backdrop" id="ef-cmd-backdrop" role="dialog" aria-modal="true" aria-label="Protosync Quick Jump">
			<div class="ef-cmd-modal">
				<div class="ef-cmd-input-row">
					<span class="ef-cmd-prefix">↘ PROTOSYNC</span>
					<input type="text" class="ef-cmd-input" id="ef-cmd-input" autocomplete="off" placeholder="{{ _('Search directive, module or route…') }}">
					<span class="ef-kbd">ESC</span>
				</div>
				<div class="ef-cmd-list" id="ef-cmd-list"></div>
				<div class="ef-cmd-footer">
					<span>↑↓ · ENTER · ESC</span>
					<span class="ef-cmd-footer-brand">
						<span class="ef-dot-matrix" aria-hidden="true"></span>
						<span>ENDFIELD INDUSTRIES // PROTOSYNC</span>
					</span>
				</div>
			</div>
		</div>

		<script>L.require('menu-endfield')</script>
		{% endif %}
	</body>
</html>
